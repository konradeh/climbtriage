# Server-side only. Never ship these to the phone.
# VLM Run gateway key for SAM 3.1 (https://app.vlm.run). Without it, hold jobs fail with a clear error.
VLMRUN_API_KEY=
# vlmrun (default) | fixture (tests/demos of the job machinery only; output stamped provenance.kind=fixture)
CLIMBTRIAGE_PROVIDER=vlmrun
CLIMBTRIAGE_DATA_DIR=./.data
# Optional shared bearer token for LAN deployments
CLIMBTRIAGE_API_TOKEN=
